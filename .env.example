# Copy to .env and fill in. Never commit .env.
# Comments must stay on their own lines: Compose env files do not strip inline comments.

# LLM provider and models (configuration only, never hardcoded).
# CHAT_PROVIDER: openai | anthropic
CHAT_PROVIDER=openai
CHAT_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Required: embeddings always use OpenAI.
OPENAI_API_KEY=
# Required only when CHAT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Ingestion (optional; defaults shown).
# MAX_UPLOAD_MB: larger uploads are rejected with 413.
# MAX_UPLOAD_MB=10
# EMBEDDING_DIMENSIONS must match the vector column created by the migrations.
# EMBEDDING_DIMENSIONS=1536
# CHUNK_SIZE and CHUNK_OVERLAP are in characters; the overlap must be smaller.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# Answering (optional; defaults shown, tuned by the RAG evaluation).
# QUESTION_MAX_CHARS: longer questions are rejected with 400.
# QUESTION_MAX_CHARS=2000
# RETRIEVAL_CANDIDATES per branch (vector, full-text) before fusion; RETRIEVAL_TOP_K after it.
# RETRIEVAL_CANDIDATES=20
# RETRIEVAL_TOP_K=6
# MIN_RELEVANCE: cosine floor (0-1) for chunks found only by the vector branch.
# MIN_RELEVANCE=0.30
# RERANK_ENABLED: one extra chat call that keeps the RERANK_TOP_N most relevant chunks.
# RERANK_ENABLED=false
# RERANK_TOP_N=4
# Prompt context budget and answer length, in tokens.
# CONTEXT_TOKEN_BUDGET=3000
# ANSWER_MAX_TOKENS=800
# Per-attempt timeout (seconds) and retries on timeouts, 429 and 5xx.
# CHAT_TIMEOUT_SECONDS=30
# CHAT_MAX_RETRIES=2
# CHAT_TEMPERATURE: sent only when set (0-2); some models reject it (e.g. reasoning models).
# CHAT_TEMPERATURE=

# Tracing (OpenTelemetry; optional, defaults shown).
# OTEL_TRACES_EXPORTER: none | console (spans on stdout) | otlp (Jaeger: run Compose with
# `--profile observability`; UI on http://localhost:16686).
# OTEL_TRACES_EXPORTER=none
# OTLP/HTTP endpoint; Compose defaults it to the jaeger service.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=cwyd-backend
# OTEL_TRACES_SAMPLER_ARG: share of new traces kept (0-1).
# OTEL_TRACES_SAMPLER_ARG=1.0
# CAPTURE_CONTENT: dev only. true adds question, prompt, chunk and answer text as span events
# (never as attributes, DOM-22). Keep false anywhere real documents are used.
# CAPTURE_CONTENT=false
# PRICE_TABLE_PATH: chat model prices (USD per million tokens) for the estimated cost per request.
# Relative to backend/ (the image's working directory); the eval reads the same table.
# PRICE_TABLE_PATH=app/prices.yaml

# API docs (optional; default shown). false removes /docs, /redoc and /openapi.json (404).
# On by default (local, homolog); set false in production.
# API_DOCS_ENABLED=true

# Owner of every document in the single-user MVP.
# DEFAULT_OWNER_ID=00000000-0000-0000-0000-000000000001

# RAG evaluation (`docker compose --profile eval run --build --rm eval`): host user that owns the
# reports written to docs/eval/ (see `id -u` / `id -g`).
# EVAL_UID=1000
# EVAL_GID=1000

# Local database credentials, read by Compose (local-only defaults shown). Compose builds the
# API's DATABASE_URL from them, so keep them URL-safe (letters, digits, - _ .): they go into the
# URL unencoded. They apply only when the db volume is created; after a change run
# `docker compose down -v`.
# POSTGRES_USER=cwyd
# POSTGRES_PASSWORD=cwyd
# POSTGRES_DB=cwyd

# Database URL, only when running the API outside Compose. Compose ignores it and builds its
# own from the POSTGRES_* values above. Requires the async driver (postgresql+asyncpg://).
# DATABASE_URL=postgresql+asyncpg://cwyd:cwyd@localhost:5432/cwyd
