# Copy to .env and fill in. Never commit .env.
# Comments must stay on their own lines: Compose env files do not strip inline comments.

# LLM provider and models (configuration only, never hardcoded).
# CHAT_PROVIDER: openai | anthropic
CHAT_PROVIDER=openai
CHAT_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Required: embeddings always use OpenAI.
OPENAI_API_KEY=
# Required only when CHAT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Ingestion (optional; defaults shown).
# MAX_UPLOAD_MB: larger uploads are rejected with 413.
# MAX_UPLOAD_MB=10
# EMBEDDING_DIMENSIONS must match the vector column created by the migrations.
# EMBEDDING_DIMENSIONS=1536
# CHUNK_SIZE and CHUNK_OVERLAP are in characters; the overlap must be smaller.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# Owner of every document in the single-user MVP.
# DEFAULT_OWNER_ID=00000000-0000-0000-0000-000000000001

# Local database. Compose builds DATABASE_URL from these (local-only defaults shown).
# Keep them URL-safe (letters, digits, - _ .): they go into the URL unencoded.
# They apply only when the db volume is created; after a change run `docker compose down -v`.
# Only when running the API outside Compose:
# DATABASE_URL=postgresql+asyncpg://cwyd:cwyd@localhost:5432/cwyd
# POSTGRES_USER=cwyd
# POSTGRES_PASSWORD=cwyd
# POSTGRES_DB=cwyd
